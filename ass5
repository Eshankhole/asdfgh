
#include <stdio.h>
#include <string.h>
int main()
{
    char str1[100], str2[100], result[200], result2[50];
    int choice;
    printf("Enter first string: ");
    gets(str1);
    printf("Enter second string: ");
    gets(str2);
    do
    {
        printf("\n\n STRING OPERATIONS ");
        printf("\n1. Find Length");
        printf("\n2. Copy String");
        printf("\n3. Concatenate Strings");
        printf("\n4. Compare Strings");
        printf("\n5. Reverse String");
        printf("\n6. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                printf("Length of first string = %d", strlen(str1));
                printf(" \n ");
                printf("length os second string = %d",strlen(str2));
                break;
            case 2:
                strcpy(result, str1);
                 strcpy(result2, str2);
                printf("Copied string = %s", result);
                printf("Copied string = %s", result2);
				break;
            case 3:
                strcpy(result, str1);
                strcat(result, str2);
                printf("Concatenated string = %s", result);
                break;
            case 4:
                if(strcmp(str1, str2) == 0)
    			{		        
                printf("Both strings are equal");   
                }
                else
                {
				printf("Both strings are not equal");
            	}
                break;
            case 5:
                strrev(str1);
                strrev(str2);
                printf("Reversed first string = %s", str1);
                printf("\n");
                printf("Reversed second string = %s ",str2);
                break;
            case 6:
                printf("Program ended.");
                break;
            default:
                printf("Invalid choice!");
        }
    }
	 while(choice != 6);
    return 0;
}
