#include<stdio.h>
int main()
{
	int i,j,r,c;
	printf("enter the number of rows and columns=");
	scanf("%d %d",&r,&c);
	printf("elements of the matrix 1 are=");
	int mat1 [r][c];
	for(i=0;i<r;i++)
	{
		for(j=0;j<c;j++)
		{
			scanf("%d",&mat1 [i][j]);
		}
	}
	printf("enter elements of matrics 2 are=");
	int mat2 [r][c];
	for(i=0;i<r;i++)
	{
		for(j=0;j<c;j++)
		{
			scanf("%d",&mat2 [i][j]);
		}
	}
	
	int sum[r][j];
	for(i=0;i<r;i++)
	{
		for(j=0;j<c;j++)
		{
			sum[i][j]=mat1 [i][j]+mat2 [i][j];
		}
	}
	printf("the adition of matrix  ");
	for(i=0;i<r;i++)
	{
		for(j=0;j<c;j++)
		{
			printf("%d",sum[i][j]);
		}
		printf("\n" "\t" "\t" "\t");
	}
	return 0;
}
