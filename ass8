#include<stdio.h>

void swap(int *a, int *b)
{
    int temp;
    temp=*a;
    *a=*b;
    *b=temp;
}

int main()
{
    int motor1,motor2;

    printf("speed of motor1=");
    scanf("%d",&motor1);

    printf("speed of motor2=");
    scanf("%d",&motor2);

    int *p1=&motor1;
    int *p2=&motor2;

    printf("speed before swapping\n");
    printf("speed of motor1=%d\n",*p1);
    printf("speed of motor2=%d\n",*p2);

    swap(p1,p2);

    printf("speeds after swapping\n");
    printf("speed of motor1=%d\n",*p1);
    printf("speed of motor2=%d\n",*p2);

    printf("address of motor1=%p\n",(void*)p1);
    printf("address of motor2=%p\n",(void*)p2);

    return 0;
}
